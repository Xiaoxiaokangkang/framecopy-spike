FRAMECOPY_DATA_DIR=./data
FRAMECOPY_QUEUE_BACKEND=local
FRAMECOPY_REDIS_URL=redis://127.0.0.1:6379/0
FRAMECOPY_SECRET_KEY=replace-with-a-long-random-secret-before-public-deployment
FRAMECOPY_RETENTION_HOURS=168
FRAMECOPY_INPUT_RETENTION_HOURS=24
FRAMECOPY_MAX_UPLOAD_BYTES=209715200
FRAMECOPY_MAX_DURATION_SECONDS=1800
# macOS 默认 Apple Vision Accurate；Linux/Windows 默认 PaddleOCR。
# 可选值：auto、apple_vision、paddleocr
FRAMECOPY_OCR_PROVIDER=auto
FRAMECOPY_OCR_FALLBACK_ENABLED=true
FRAMECOPY_OCR_TIMEOUT_SECONDS=45
FRAMECOPY_APPLE_VISION_LANGUAGES=zh-Hans,zh-Hant,en-US
# 语音识别依赖为可选项：macOS Apple Silicon 使用 uv sync --extra speech 安装。
FRAMECOPY_SPEECH_PROVIDER=mlx_whisper
FRAMECOPY_SPEECH_MODEL=mlx-community/whisper-large-v3-turbo
# 留空时优先使用项目根目录的 .venv-speech/bin/python。
FRAMECOPY_SPEECH_PYTHON=
FRAMECOPY_SPEECH_TIMEOUT_SECONDS=2700
# 首页配置元宝 Cookie 后可直接解析视频号链接；电脑版微信仅作回退通道。
FRAMECOPY_WX_PROVIDER_COMMAND=./.venv/bin/python ./scripts/wx_channel_provider.py

